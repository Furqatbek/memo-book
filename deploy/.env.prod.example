# Copy to .env (in this deploy/ directory) and fill in every CHANGE_ME.
# Generate secrets with:  openssl rand -hex 32

# ---- Host ----
# Your domain. DNS A records required BEFORE first start (Let's Encrypt):
#   rspixel.uz          -> VPS IP   (site + editor + API, one origin)
#   api.rspixel.uz      -> VPS IP
#   storage.rspixel.uz  -> VPS IP
#   www.rspixel.uz      -> VPS IP   (optional, redirects to the root)
DOMAIN=rspixel.uz

ENV=prod
DEBUG=false

# ---- Postgres (runs on this VPS) ----
POSTGRES_PASSWORD=CHANGE_ME_PG
# Same password again here — docker env files don't expand variables.
DATABASE_URL=postgresql+asyncpg://memobook:CHANGE_ME_PG@postgres:5432/memobook

# ---- Redis (runs on this VPS) ----
REDIS_URL=redis://redis:6379/0

# ---- Storage: MinIO on this VPS, bytes live in a local Docker volume ----
MINIO_ROOT_USER=memobook
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
# The backend signs upload/download URLs against this endpoint, and browsers
# use those URLs directly — it must be the PUBLIC storage hostname.
# (Server-side storage traffic goes straight to the minio container.)
S3_PUBLIC_URL=https://storage.rspixel.uz
# Same credentials as MINIO_ROOT_* above.
S3_ACCESS_KEY=memobook
S3_SECRET_KEY=CHANGE_ME_MINIO
S3_BUCKET=memobook
S3_REGION=us-east-1

# Origins allowed to upload/fetch photos in the browser: the VPS-hosted
# editor origins and, if used, the GitHub Pages editor.
STORAGE_CORS_ORIGINS=https://rspixel.uz,https://api.rspixel.uz,https://furqatbek.github.io

# ---- API <-> browser ----
# Only needed for an editor hosted on ANOTHER origin (e.g. GitHub Pages).
# The editor served at https://api.rspixel.uz/editor/ needs no CORS.
CORS_ORIGINS=https://furqatbek.github.io

# ---- Jobs ----
TASK_EAGER=false

# ---- Payments ----
# Dev mode until a real acquirer (Payme/Click/Uzum) is integrated: any
# webhook signed with DEV_PAYMENT_SECRET marks an order paid. Keep the
# secret strong and private; set DEV_PAYMENTS_ENABLED=false the moment a
# real provider is live.
DEV_PAYMENTS_ENABLED=true
DEV_PAYMENT_SECRET=CHANGE_ME_SECRET

# Card-transfer pilot: this card is shown on the order page with the
# amount to transfer. Leave empty to hide the card block.
PAY_CARD_NUMBER=8600 0000 0000 0000
PAY_CARD_HOLDER=FIRSTNAME LASTNAME
# Trust-first flow: checkout confirms the order immediately (PDFs render,
# the Telegram notification fires) without waiting for a payment callback.
# YOU verify the bank transfer before printing/shipping — check with:
#   docker compose -f docker-compose.prod.yml exec api \
#       python scripts/confirm_payment.py --list
# Set to false when a real acquirer (Payme/Click/Uzum) is integrated.
AUTO_CONFIRM_ORDERS=true

# ---- Rate limiting (per IP, per minute) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BOOK_CREATE_PER_MIN=30
RATE_LIMIT_UPLOAD_URL_PER_MIN=240
RATE_LIMIT_WEBHOOK_PER_MIN=120

# ---- Render ----
RENDER_COLOR_MODE=rgb
ICC_PROFILE_PATH=

# ---- Cover spine widths (mm) — PLACEHOLDERS until the printer confirms ----
SPINE_MM_16=4.0
SPINE_MM_32=6.0
SPINE_MM_48=8.0
SPINE_MM_96=14.0

# ---- Prices per tier, UZS in tiyin — PLACEHOLDERS, set real prices ----
PRICE_MINOR_16=29900000
PRICE_MINOR_32=39900000
PRICE_MINOR_48=49900000
PRICE_MINOR_96=79900000

# ---- Telegram order notifications ----
# 1. In Telegram, message @BotFather -> /newbot -> copy the token here.
# 2. Message your new bot (or add it to the operators group and write there).
# 3. Leave TELEGRAM_CHAT_ID empty and run:
#      docker compose -f docker-compose.prod.yml exec api \
#          python scripts/telegram_check.py
#    It prints the chat ids the bot can see — put the right one below,
#    restart (docker compose up -d), and run the check again: a test
#    message should arrive. Paid orders then deliver the print-PDF links
#    to this chat automatically.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
