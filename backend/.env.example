# Every environment variable the backend reads. Copy to .env for local dev.
# Values below match docker-compose defaults.

# --- App ---
APP_NAME=memo-book-backend
ENV=dev                 # dev | staging | prod
DEBUG=false

# --- Postgres ---
DATABASE_URL=postgresql+asyncpg://memobook:memobook@localhost:5432/memobook

# --- Redis (queue + rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, any S3-compatible provider in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=memobook
S3_REGION=us-east-1

# --- Readiness probe ---
READY_CHECK_TIMEOUT_S=2.0

# --- Telegram (Milestone 11; leave empty until then) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
