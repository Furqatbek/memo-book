# Every environment variable the backend reads. Copy to .env for local dev.
# Values below match docker-compose defaults.

# --- App ---
APP_NAME=memo-book-backend
ENV=dev                 # dev | staging | prod
DEBUG=false

# --- Postgres ---
DATABASE_URL=postgresql+asyncpg://memobook:memobook@localhost:5432/memobook

# --- Redis (queue + rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, any S3-compatible provider in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=memobook
S3_REGION=us-east-1

# --- Readiness probe ---
READY_CHECK_TIMEOUT_S=2.0

# --- Jobs ---
# true = run queue jobs inline (tests / single-process dev); false = RQ worker
TASK_EAGER=false

# --- Payments (dev mode) ---
# The "dev" provider marks any correctly-signed webhook as paid.
# Disable and integrate a real acquirer (Payme/Click/Uzum) for production.
DEV_PAYMENTS_ENABLED=true
DEV_PAYMENT_SECRET=dev-secret-change-me

# --- Rate limiting (per IP, per minute) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BOOK_CREATE_PER_MIN=30
RATE_LIMIT_UPLOAD_URL_PER_MIN=240
RATE_LIMIT_WEBHOOK_PER_MIN=120

# --- Render ---
# "rgb" (canonical, deterministic) or "cmyk" (Ghostscript + printer ICC).
RENDER_COLOR_MODE=rgb
ICC_PROFILE_PATH=

# --- Cover geometry: spine width (mm) per page tier ---
# PLACEHOLDERS — replace with the printer's real numbers before production.
SPINE_MM_16=4.0
SPINE_MM_32=6.0
SPINE_MM_48=8.0
SPINE_MM_96=14.0

# --- Prices per tier, UZS in tiyin (1 sum = 100 tiyin) ---
# PLACEHOLDERS — set the real prices before going live.
PRICE_MINOR_16=29900000
PRICE_MINOR_32=39900000
PRICE_MINOR_48=49900000
PRICE_MINOR_96=79900000

# --- Telegram (Milestone 11; leave empty until then) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Frontend editor ---
# Origins allowed to call the API from a browser, comma-separated
# (e.g. https://furqatbek.github.io). Empty = no cross-origin access.
CORS_ORIGINS=
# Serve the static editor from this directory at /editor (dev convenience).
EDITOR_DIR=../editor
# Serve the marketing site at / (empty = disabled; the prod image sets it).
SITE_DIR=
